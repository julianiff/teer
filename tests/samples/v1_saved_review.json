      "old_content": "pub fn total(items: &[u32]) -> u32 {\n    items.iter().sum()\n}\n\npub fn refund(amount: u32, fee: u32) -> u32 {\n    amount - fee\n}\n\npub fn label(name: &str) -> String {\n    format!(\"item {name}\")\n}\n\npub fn retry(times: u32) -> u32 {\n    times\n}\n",
      "new_content": "pub fn total(items: &[u32]) -> u32 {\n    items.iter().copied().sum::<u32>() + 1\n}\n\npub fn refund(amount: u32, fee: u32) -> u32 {\n    amount.saturating_sub(fee)\n}\n\npub fn label(name: &str) -> String {\n    format!(\"item: {name}\")\n}\n\npub fn retry(times: u32) -> u32 {\n    times.min(3)\n}\n\npub fn audit(amount: u32) -> bool {\n    amount > 1000\n}\n"
    }
